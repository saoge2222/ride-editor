import { ScrollView } from "std-widgets.slint";
import "fonts/SourceHanSans-VF.ttf.ttc";

export struct FileEntryModel {
    name: string,
    path: string,
    is-dir: bool,
    depth: int,
}

export component FileExplorer {
    in-out property <bool> open: false;
    in-out property <length> user-width: 200px;
    in-out property <[FileEntryModel]> entries;
    in-out property <string> current-path: "";
    property <length> drag-start-width;
    property <bool> dragging: false;
    callback expand-folder(string);
    callback open-file(string);

    visible: root.open;
    width: root.user-width;

    Rectangle {
        background: #313335;

        VerticalLayout {
            spacing: 0;

            Rectangle {
                height: 28px;
                background: #2B2D2E;

                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;

                    Text {
                        text: "EXPLORER";
                        color: #A9B7C6;
                        font-family: "Source Han Sans VF";
                        font-size: 11px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Text {
                        text: root.current-path;
                        color: #6A7B8C;
                        font-family: "Source Han Sans VF";
                        font-size: 10px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                    }
                }
            }

            Rectangle {
                background: transparent;
                vertical-stretch: 1;

                ScrollView {
                    VerticalLayout {
                        spacing: 0;

                        for entry in root.entries : Rectangle {
                            height: 24px;
                            background: entry-touch.has-hover ? #3C3F41 : transparent;

                            entry-touch := TouchArea {
                                clicked => {
                                    if entry.is-dir {
                                        root.expand-folder(entry.path);
                                    } else {
                                        root.open-file(entry.path);
                                    }
                                }
                            }

                            HorizontalLayout {
                                padding-left: 12px + entry.depth * 16px;
                                padding-right: 8px;
                                spacing: 6px;

                                if entry.is-dir : Text {
                                    text: "▸";
                                    color: #808080;
                                    font-size: 9px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: entry.is-dir ? "📁" : "📄";
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: entry.name;
                                    color: entry.is-dir ? #4A90D9 : #A9B7C6;
                                    font-family: "Source Han Sans VF";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }
        }

        handle := Rectangle {
            width: 4px;
            background: touch.has-hover || touch.pressed ? #4A4D50 : transparent;
            x: parent.width - 4px;
            y: 0;
            height: 100%;

            touch := TouchArea {
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                        root.dragging = true;
                        root.drag-start-width = root.user-width;
                    }
                    if root.dragging && event.kind == PointerEventKind.move {
                        root.user-width = max(50px, root.drag-start-width + touch.mouse-x - touch.pressed-x);
                    }
                    if event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel {
                        root.dragging = false;
                    }
                }
            }
        }
    }
}
