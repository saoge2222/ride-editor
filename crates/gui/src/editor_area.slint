import { ScrollView, TextEdit } from "std-widgets.slint";
import "fonts/MapleMono-TTF/MapleMono-Regular.ttf";
import "fonts/SourceHanSans-VF.ttf.ttc";

export struct EditorTabItem {
    file-name: string,
    file-path: string,
}

export component EditorArea {
    in-out property <[EditorTabItem]> tabs;
    in-out property <int> active-index: -1;
    in-out property <string> editor-text: "";
    in-out property <string> line-numbers-text: "";
    callback tab-clicked(int);
    callback tab-close-requested(int);
    callback editor-text-changed();

    VerticalLayout {
        spacing: 0;

        if root.tabs.length > 0 : Rectangle {
            height: 28px;
            background: #2B2D2E;

            HorizontalLayout {
                spacing: 0;

                for tab[tab-idx] in root.tabs : Rectangle {
                    height: 28px;
                    min-width: 100px;
                    background: tab-idx == root.active-index ? #3C3F41 : #2B2D2E;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 6px;
                        spacing: 6px;

                        Text {
                            text: tab.file-name;
                            color: tab-idx == root.active-index ? #BBBBBB : #808080;
                            font-family: "Source Han Sans VF";
                            font-size: 11px;
                            vertical-alignment: center;
                        }

                        close-btn := Rectangle {
                            width: 14px;
                            height: 14px;
                            border-radius: 2px;
                            background: close-touch.has-hover ? #555555 : transparent;

                            Text {
                                text: "×";
                                color: #808080;
                                font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            close-touch := TouchArea {
                                clicked => { root.tab-close-requested(tab-idx); }
                            }
                        }
                    }

                    tab-touch := TouchArea {
                        clicked => { root.tab-clicked(tab-idx); }
                    }
                }
            }
        }

        Rectangle {
            background: #2B2B2B;
            vertical-stretch: 1;

            if root.tabs.length == 0 : Text {
                text: "No files open";
                color: #555555;
                font-family: "Source Han Sans VF";
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if root.tabs.length > 0 : ScrollView {
                HorizontalLayout {
                    Rectangle {
                        background: #313335;
                        width: 52px;

                        TextEdit {
                            text <=> root.line-numbers-text;
                            font-family: "Maple Mono";
                            font-size: 13px;
                        }
                    }

                    TextEdit {
                        text <=> root.editor-text;
                        font-family: "Maple Mono";
                        font-size: 13px;

                        edited() => {
                            root.editor-text-changed();
                        }
                    }
                }
            }
        }
    }
}
